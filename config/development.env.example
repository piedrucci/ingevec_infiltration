APP_ENV=development
APP_NAME=Capix Ingevec API
API_PREFIX=/v1
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require
NATS_URL=nats://nats:4222
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_REGION=us-east-1
S3_BUCKET=capix-documents-development
S3_ACCESS_KEY=change-me-development
S3_SECRET_KEY=change-me-development
GEMINI_API_KEY=replace-with-development-key
GEMINI_MODEL=gemini-2.5-flash
OIDC_ISSUER=http://keycloak:8080/realms/capix-development
OIDC_AUDIENCE=capix-api
OIDC_JWKS_URL=http://keycloak:8080/realms/capix-development/protocol/openid-connect/certs
PRESIGNED_URL_TTL_SECONDS=3600
MAX_EXCEL_SIZE_BYTES=26214400
MAX_PDF_SIZE_BYTES=5242880
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-development
KEYCLOAK_DB_PASSWORD=change-me-development
KEYCLOAK_HOSTNAME=localhost
SUPERSET_SECRET_KEY=change-me-to-a-long-random-development-secret
SUPERSET_DATABASE_URI=postgresql+psycopg2://USER:PASSWORD@YOUR_NEON_HOST/superset?sslmode=require
