APP_ENV=production
APP_NAME=Capix Ingevec API
API_PREFIX=/v1
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require
NATS_URL=nats://nats:4222
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_REGION=us-east-1
S3_BUCKET=capix-documents-production
S3_ACCESS_KEY=replace-with-production-key
S3_SECRET_KEY=replace-with-production-key
GEMINI_API_KEY=replace-with-production-key
GEMINI_MODEL=gemini-2.5-flash
OIDC_ISSUER=https://auth.capix.cloud/realms/capix-production
OIDC_AUDIENCE=capix-api
OIDC_JWKS_URL=http://keycloak:8080/realms/capix-production/protocol/openid-connect/certs
PRESIGNED_URL_TTL_SECONDS=3600
MAX_EXCEL_SIZE_BYTES=26214400
MAX_PDF_SIZE_BYTES=5242880
KEYCLOAK_ADMIN=replace-with-admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-long-random-value
KEYCLOAK_DB_PASSWORD=replace-with-long-random-value
KEYCLOAK_HOSTNAME=auth.capix.cloud
SUPERSET_SECRET_KEY=replace-with-long-random-value
SUPERSET_DATABASE_URI=postgresql+psycopg2://USER:PASSWORD@YOUR_NEON_HOST/superset?sslmode=require
