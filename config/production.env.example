APP_ENV=production
ENV_FILE=.env.production
SEAWEEDFS_CONFIG_FILE=../files/seaweedfs/s3.json
APP_NAME=Capix Ingevec API
API_PREFIX=/v1
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require
NATS_URL=nats://nats:4222
REDIS_URL=redis://redis:6379/0
DASHBOARD_CACHE_TTL_SECONDS=300
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_REGION=us-east-1
S3_BUCKET=capix-documents-production
S3_ACCESS_KEY=replace-with-production-key
S3_SECRET_KEY=replace-with-production-key
GEMINI_API_KEY=replace-with-production-key
GEMINI_MODEL=gemini-2.5-flash
OIDC_ISSUER=https://auth.capix.cloud/realms/ingevec-production
OIDC_AUDIENCE=ingevec-api
OIDC_JWKS_URL=http://keycloak:8080/realms/ingevec-production/protocol/openid-connect/certs
VITE_KEYCLOAK_URL=https://auth.capix.cloud
VITE_KEYCLOAK_REALM=ingevec-production
VITE_KEYCLOAK_CLIENT_ID=ingevec-web
PRESIGNED_URL_TTL_SECONDS=3600
MAX_EXCEL_SIZE_BYTES=26214400
MAX_PDF_SIZE_BYTES=5242880
PDF_SCAN_INTERVAL_SECONDS=60
KEYCLOAK_ADMIN=replace-with-admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-long-random-value
KEYCLOAK_DB_PASSWORD=replace-with-long-random-value
KEYCLOAK_HOSTNAME=auth.capix.cloud
KEYCLOAK_INITIAL_ADMIN_USERNAME=replace-with-production-admin-username
KEYCLOAK_INITIAL_ADMIN_EMAIL=admin@example.com
KEYCLOAK_INITIAL_ADMIN_PASSWORD=replace-with-long-random-value
KEYCLOAK_INITIAL_VIEWER_USERNAME=replace-with-production-viewer-username
KEYCLOAK_INITIAL_VIEWER_EMAIL=viewer@example.com
KEYCLOAK_INITIAL_VIEWER_PASSWORD=replace-with-long-random-value
KEYCLOAK_INITIAL_VIEWER_GROUPS=
SUPERSET_SECRET_KEY=replace-with-long-random-value
SUPERSET_DB_PASSWORD=replace-with-strong-superset-db-password
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=replace-with-strong-superset-admin-password
SUPERSET_ADMIN_FIRSTNAME=Ingevec
SUPERSET_ADMIN_LASTNAME=Administrador
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_ANALYTICS_DB_PASSWORD=replace-with-strong-reader-password
SUPERSET_OIDC_PUBLIC_URL=https://auth.capix.cloud
SUPERSET_OIDC_INTERNAL_URL=http://keycloak:8080
SUPERSET_OIDC_REALM=ingevec-production
SUPERSET_OIDC_CLIENT_ID=ingevec-superset
SUPERSET_OIDC_CLIENT_SECRET=replace-with-keycloak-client-secret
