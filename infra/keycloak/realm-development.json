{
  "realm": "ingevec-development",
  "enabled": true,
  "displayName": "Ingevec Postventa",
  "roles": {
    "realm": [
      { "name": "admin", "description": "Administrates Ingevec postventa" },
      { "name": "viewer", "description": "Views Ingevec postventa" },
      { "name": "superset_admin", "description": "Administrates Ingevec analytics" },
      { "name": "superset_viewer", "description": "Views assigned Ingevec analytics" }
    ]
  },
  "clients": [
    {
      "clientId": "ingevec-api",
      "name": "Ingevec API",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "ingevec-web",
      "name": "Ingevec Admin Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:5173/*", "https://app.capix.cloud/*"],
      "webOrigins": ["http://localhost:5173", "https://app.capix.cloud"],
      "protocolMappers": [
        {
          "name": "ingevec-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ingevec-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "ingevec-superset",
      "name": "Ingevec Superset",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:8088/oauth-authorized/keycloak", "https://bi.capix.cloud/oauth-authorized/keycloak"],
      "webOrigins": ["http://localhost:8088", "https://bi.capix.cloud"],
      "protocolMappers": [{
        "name": "superset groups",
        "protocol": "openid-connect",
        "protocolMapper": "oidc-group-membership-mapper",
        "consentRequired": false,
        "config": {"full.path": "true", "claim.name": "groups", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true"}
      }]
    }
  ]
}
